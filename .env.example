# Chế độ lưu trữ: "local" (IndexedDB trên máy - mặc định giai đoạn đầu) hoặc "supabase" (Phiên 7)
VITE_DATA_ADAPTER=local

# Cấu hình Supabase (điền ở Phiên 7 — chỉ dùng ANON_KEY ở frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API Key (điền ở Phiên 3 — chỉ dùng phía Netlify Function backend, KHÔNG gắn tiền tố VITE_)
GEMINI_API_KEY=
